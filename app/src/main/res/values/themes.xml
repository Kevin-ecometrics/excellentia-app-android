<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Sharp/rectangular corners everywhere (brand board), applied as the theme-wide
         M3 shape default so buttons/cards/chips/dialogs/text-fields need no per-view
         cornerRadius override. Individual screens keep only the intentionally-circular
         elements (avatars, status dots, FAB, toggle knobs). -->
    <style name="ShapeAppearance.Excellentia.None" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>


    <style name="TextAppearance.Excellentia.Display" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/family_after</item>
        <item name="android:fontFamily">@font/family_after</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.Excellentia.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg_color</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="chipStrokeColor">@color/chip_stroke_color</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="rippleColor">@color/ex_green_tint</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Excellentia.None</item>
    </style>

    <style name="Widget.Excellentia.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/ex_input_stroke</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="hintTextColor">@color/ex_green</item>
        <item name="android:textColorHint">@color/ex_ink_faint</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Excellentia.None</item>
    </style>

    <!-- Modal dialogs (MaterialAlertDialogBuilder) don't inherit the app's chunky
         filled-button language by default — M3 renders OK/Cancel as flat text links.
         This makes every dialog (edit price, edit weight, manual entry, etc.) match
         the bold "After"-font, sharp-corner, brand-filled button style used everywhere
         else in the app (per the Claude Design mockup). -->
    <style name="ThemeOverlay.Excellentia.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Excellentia.Title.Text</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Excellentia.Button.Dialog.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Excellentia.Button.Dialog.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Excellentia.Button.Dialog.Negative</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Excellentia.None</item>
    </style>

    <style name="MaterialAlertDialog.Excellentia.Title.Text" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:fontFamily">@font/family_after</item>
        <item name="fontFamily">@font/family_after</item>
        <item name="android:textColor">@color/ex_green</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Excellentia.Button.Dialog.Positive" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/family_after</item>
        <item name="fontFamily">@font/family_after</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="backgroundTint">@color/ex_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <!-- Gap from whichever button sits to its left (Negative/Neutral) — both
             are now solid filled blocks, not text links, so without this they
             render flush against each other with no visible seam. -->
        <item name="android:layout_marginStart">8dp</item>
    </style>

    <!-- Solid navy block, not a text link — matches the "Cancelar" button used
         everywhere else in the app (ProductDetailActivity, SignatureActivity,
         CurrentOrderActivity, etc. all pair a navy secondary action next to a
         green primary one, never a plain text button). -->
    <style name="Widget.Excellentia.Button.Dialog.Negative" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/family_after</item>
        <item name="fontFamily">@font/family_after</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="backgroundTint">@color/ex_navy</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <!-- Same reasoning as Positive above — matters when both Negative and
             Neutral are shown together (Neutral first, Negative second). -->
        <item name="android:layout_marginStart">8dp</item>
    </style>

    <!-- Snackbar.make() calls across the app (offline banners, save
         confirmations, retry errors) rendered with Material's default dark
         gray/black pill — nowhere else in the app uses that color. Rewired to
         the brand's darkest green with a gold action label. -->
    <style name="Widget.Excellentia.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/ex_green_deep</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Excellentia.None</item>
    </style>

    <style name="Widget.Excellentia.Snackbar.TextView" parent="Widget.MaterialComponents.Snackbar.TextView">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.Excellentia.Snackbar.Button" parent="Widget.MaterialComponents.Button.TextButton.Snackbar">
        <item name="android:textColor">@color/ex_gold</item>
    </style>

    <!-- Native android.app.DatePickerDialog (CreatePreOrderActivity) isn't a
         Material dialog and ignores materialAlertDialogTheme — it only reads
         the platform android:datePickerDialogTheme attribute. Without this the
         selected-day highlight and OK/Cancel buttons render in stock Android
         teal instead of the brand green. -->
    <style name="ThemeOverlay.Excellentia.DatePicker" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/ex_green</item>
        <item name="android:colorAccent">@color/ex_green</item>
    </style>

    <style name="Base.Theme.Test" parent="Theme.Material3.Light.NoActionBar">
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Excellentia.MaterialAlertDialog</item>
        <item name="android:datePickerDialogTheme">@style/ThemeOverlay.Excellentia.DatePicker</item>
        <item name="snackbarStyle">@style/Widget.Excellentia.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/Widget.Excellentia.Snackbar.TextView</item>
        <item name="snackbarButtonStyle">@style/Widget.Excellentia.Snackbar.Button</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/light_primary</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>
        <item name="colorSecondary">@color/ex_navy</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/light_primary</item>
        <item name="colorTertiary">@color/ex_gold</item>
        <item name="colorOnTertiary">@color/ex_green</item>
        <item name="colorError">@color/red</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/error_light</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/ex_cream</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/light_gray</item>
        <!-- Full M3 role set filled in with brand tokens — Theme.Material3.Light's
             baseline defaults for any UNSET role fall back to Google's stock purple
             palette, which was leaking through on Chip/Switch/BottomNav selected
             states before these were added. -->
        <item name="colorOnSecondaryContainer">@color/ex_green</item>
        <item name="colorTertiaryContainer">@color/ex_warning_tint</item>
        <item name="colorOnTertiaryContainer">@color/ex_green</item>
        <item name="colorOnErrorContainer">@color/ex_danger</item>
        <item name="colorSurfaceDim">@color/ex_cream</item>
        <item name="colorSurfaceBright">@color/white</item>
        <item name="colorSurfaceContainerLowest">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/ex_cream</item>
        <item name="colorSurfaceContainer">@color/ex_green_tint</item>
        <item name="colorSurfaceContainerHigh">@color/ex_line</item>
        <item name="colorSurfaceContainerHighest">@color/ex_line_strong</item>
        <item name="colorPrimaryFixed">@color/ex_green_tint</item>
        <item name="colorPrimaryFixedDim">@color/ex_green</item>
        <item name="colorOnPrimaryFixed">@color/ex_green_deep</item>
        <item name="colorOnPrimaryFixedVariant">@color/ex_green</item>
        <item name="colorSecondaryFixed">@color/ex_green_tint</item>
        <item name="colorSecondaryFixedDim">@color/ex_navy</item>
        <item name="colorOnSecondaryFixed">@color/ex_navy</item>
        <item name="colorOnSecondaryFixedVariant">@color/ex_navy</item>
        <item name="colorTertiaryFixed">@color/ex_warning_tint</item>
        <item name="colorTertiaryFixedDim">@color/ex_gold</item>
        <item name="colorOnTertiaryFixed">@color/ex_green</item>
        <item name="colorOnTertiaryFixedVariant">@color/ex_green</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Excellentia.None</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Excellentia.None</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Excellentia.None</item>
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.Excellentia.None</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Excellentia.None</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Excellentia.None</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Excellentia.None</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Excellentia.None</item>
    </style>

    <style name="Theme.Test" parent="Base.Theme.Test">
        <item name="android:windowAnimationStyle">@style/WindowAnimation.Slide</item>
    </style>

    <style name="Theme.Test.Splash" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/ex_green</item>
        <item name="android:navigationBarColor">@color/ex_green</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="WindowAnimation.Slide" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>
</resources>
