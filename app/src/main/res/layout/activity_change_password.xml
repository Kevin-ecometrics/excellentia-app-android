<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/ex_navy"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/white"
            app:title="@string/title_change_password"
            app:titleTextColor="@color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Bordered box + static label, no TextInputLayout (same pattern
                 as Login) — Material's outline notch-cutout hint mechanic was
                 clipping label text at the top combined with sharp corners. -->
            <LinearLayout
                android:id="@+id/wrapCurrentPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_field"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/hint_current_password"
                    android:textAllCaps="true"
                    android:textColor="@color/ex_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etCurrentPassword"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:inputType="textPassword"
                        android:minHeight="0dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/ex_ink"
                        android:textColorHint="@color/ex_ink_faint"
                        android:textSize="16sp" />

                    <ImageButton
                        android:id="@+id/btnToggleCurrentPassword"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:background="@null"
                        android:contentDescription="@string/hint_current_password"
                        android:padding="0dp"
                        android:src="@drawable/ic_eye"
                        app:tint="@color/ex_ink_soft" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wrapNewPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_field"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/hint_new_password"
                    android:textAllCaps="true"
                    android:textColor="@color/ex_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etNewPassword"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:inputType="textPassword"
                        android:minHeight="0dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/ex_ink"
                        android:textColorHint="@color/ex_ink_faint"
                        android:textSize="16sp" />

                    <ImageButton
                        android:id="@+id/btnToggleNewPassword"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:background="@null"
                        android:contentDescription="@string/hint_new_password"
                        android:padding="0dp"
                        android:src="@drawable/ic_eye"
                        app:tint="@color/ex_ink_soft" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wrapConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_field"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/hint_confirm_password"
                    android:textAllCaps="true"
                    android:textColor="@color/ex_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:inputType="textPassword"
                        android:minHeight="0dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/ex_ink"
                        android:textColorHint="@color/ex_ink_faint"
                        android:textSize="16sp" />

                    <ImageButton
                        android:id="@+id/btnToggleConfirmPassword"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:background="@null"
                        android:contentDescription="@string/hint_confirm_password"
                        android:padding="0dp"
                        android:src="@drawable/ic_eye"
                        app:tint="@color/ex_ink_soft" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@color/ex_green_tint"
                android:lineSpacingExtra="2dp"
                android:padding="14dp"
                android:text="@string/label_password_requirements"
                android:textColor="@color/ex_green"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/ex_danger_tint"
                android:padding="12dp"
                android:textColor="@color/ex_danger"
                android:textSize="13sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/family_after"
                android:text="@string/btn_save_password"
                android:textColor="@color/white"
                app:backgroundTint="@color/ex_green"
                app:cornerRadius="0dp"
                app:elevation="4dp"
                app:strokeColor="@color/white"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
